NODE_ENV=development
PORT=5000
CLIENT_ORIGINS=http://localhost:5173

# Generate each with: node -e "console.log(require(\x27crypto\x27).randomBytes(48).toString(\x27hex\x27))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# MongoDB Atlas (or local) connection string. Leave empty in development to use a temporary in-memory DB.
MONGODB_URI=

# lax is right for localhost and same-site custom domains
COOKIE_SAMESITE=lax
